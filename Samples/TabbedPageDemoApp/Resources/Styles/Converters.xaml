<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:ValueConverters;assembly=ValueConverters"
    xmlns:converters="clr-namespace:TabbedPageDemoApp.Converters">

    <c:BoolInverter x:Key="BoolInverter" />
    <c:BoolToImageSourceConverter
        x:Key="BoolToCollapseExpandImageConverter"
        FalseValue="ic_chevron_down"
        TrueValue="ic_chevron_up" />

    <converters:StringToThicknessConverter x:Key="StringToThicknessConverter" />
</ResourceDictionary>